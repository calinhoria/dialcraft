{
  "name": "dialcraft",
  "version": "0.2.3",
  "description": "Dialcraft — a watchface designer for Zepp OS / Amazfit watches: visual editor, Zeus CLI export, .zab build and Wi-Fi install",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist-mac": "electron-builder --mac",
    "dist-win": "electron-builder --win",
    "dist-linux": "electron-builder --linux",
    "css": "tailwindcss -i styles-src.css -o styles.css --minify",
    "masks": "node tools/gen-masks.js",
    "sample": "node tools/make-sample.js",
    "smoke": "electron tools/smoke.js",
    "shots": "electron tools/shot.js",
    "icon": "electron tools/make-icon.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.dialcraft.app",
    "productName": "Dialcraft",
    "files": [
      "build/icon.png",
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "vendor/**/*",
      "renderer.js",
      "assets/fonts/**/*",
      "assets/masks/**/*",
      "core/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Calin Belut <calinhoria@users.noreply.github.com>"
    },
    "icon": "build/icon.png",
    "nsis": {
      "artifactName": "Dialcraft-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Dialcraft-${version}-portable.${ext}"
    },
    "afterPack": "tools/adhoc-sign.js"
  }
}
