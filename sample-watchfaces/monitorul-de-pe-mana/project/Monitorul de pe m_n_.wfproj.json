  "userCode": "{\n  // Monitorul de pe mână: the tag blinks and a red ticker runs the headlines, forever\n  const MS = 100, TX0 = 36, TL = 1453, CW = 290.6, K = 5, SPEED = 70;\n  const V = {\"tag\":{\"b\":0,\"a\":1,\"__blank\":2},\"tk0\":{\"s\":0,\"__blank\":1},\"tk1\":{\"__blank\":0,\"s\":1},\"tk2\":{\"__blank\":0,\"s\":1},\"tk3\":{\"__blank\":0,\"s\":1},\"tk4\":{\"__blank\":0,\"s\":1},\"CoverL\":{\"s\":0,\"__blank\":1},\"CoverR\":{\"s\":0,\"__blank\":1}};\n  const tick = () => {\n    const now = Date.now();\n    slot('tag')(36, 232, V.tag[Math.floor(now / 500) % 2 ? 'a' : 'b']);\n    const off = (now / 1000 * SPEED) % TL;\n    for (let i = 0; i < K; i++) { const p = (((i * CW - off) % TL) + TL) % TL; slot('tk' + i)(Math.round(TX0 + (p > TL - CW ? p - TL : p)), 394, V['tk' + i].s); }\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
