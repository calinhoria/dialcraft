  "userCode": "// <smooth-second-hand>\n// Generated by the \"Smooth second hand\" preset: the watch turns the hand (anim_steps on prop.ANGLE). Each animation runs from the current angle\n// to the next SPAN mark (60 s: the end of the minute; its length is exactly the time left) and the next one starts just after it, from the real time, so the hand can\n// never run more than a few seconds off. The running animation is stopped (ANIM_STATUS) before another starts and when the screen goes off:\n// two animations on one hand fight each other (measured on a Bip 6: the hand jumped back a few seconds, and after wake-up it showed a stale angle).\n// If the animation is refused, the hand moves once a second instead. Do not edit between the markers; apply the preset again to refresh.\n{\n  const G = globalThis, SPAN = 60000;     // 10000 was the length that worked on a Bip 6; 60000 is being compared (one restart a minute)\n  let aid = null;\n  const kill = () => {\n    try { if (aid != null && W.smoothsec && ui.anim_status) W.smoothsec.setProperty(ui.prop.ANIM_STATUS, { anim_id: aid, anim_status: ui.anim_status.STOP }); } catch (e) {}\n    aid = null;\n  };\n  const turn = () => {\n    const h = W.smoothsec; if (!h) return 1000;\n    const d = new Date(), ms = d.getSeconds() * 1000 + d.getMilliseconds(), left = SPAN - (ms % SPAN);\n    kill();\n    try {\n      if (!ui.prop.ANIM) throw new Error('no ANIM');\n      aid = h.setProperty(ui.prop.ANIM, { anim_steps: [{ anim_prop: ui.prop.ANGLE, anim_from: ms * 0.006, anim_to: (ms + left) * 0.006, anim_rate: 'linear', anim_duration: left, anim_offset: 0 }], anim_fps: 25, anim_repeat: 0 });     // 60 looked the same on a Bip 6, so the default stays\n      return left + 3;\n    } catch (e) {\n      h.setProperty(ui.prop.ANGLE, Math.round(ms / 1000) * 6 % 360);\n      return 1000 - (Date.now() % 1000) + 2;\n    }\n  };\n  const loop = (g) => { if (g !== G.__ssGen) return; let n = 1000; try { n = turn(); } catch (e) {} try { setTimeout(() => loop(g), n); } catch (e) {} };\n  const stop = () => { G.__ssGen = (G.__ssGen || 0) + 1; kill(); };\n  const start = () => { stop(); loop(G.__ssGen); };\n  start();\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { pause_call: stop, resume_call: start });\n}\n// </smooth-second-hand>\n",
  "userImports": ""
