  "savePath": null,
  "userCode": "{\n  const MS = 130\n  const t0 = Date.now()\n  // ping-pong along a range: the position and the direction (1 right, -1 left) at time t (s)\n  const pp = (t, speed, a, b, ph) => { const L = b - a, d = ((speed * t + ph) % (2 * L) + 2 * L) % (2 * L); return d < L ? [a + d, 1] : [b - (d - L), -1] }\n  const D = [\n    { w: W.hen, W2: 100, OX: 70, WL: 34, wl: 322, lag: 0, spd: 9, ph: 150, a: -70, b: 460, dir: 1 },\n    { w: W.dk0, W2: 50, OX: 35, WL: 17, wl: 326, lag: 1.6, spd: 9, ph: 150, a: -70, b: 460, dir: 1 },\n    { w: W.dk1, W2: 50, OX: 35, WL: 17, wl: 327, lag: 2.7, spd: 9, ph: 150, a: -70, b: 460, dir: 1 },\n    { w: W.dk2, W2: 50, OX: 35, WL: 17, wl: 326, lag: 3.8, spd: 9, ph: 150, a: -70, b: 460, dir: 1 },\n    { w: W.drake, W2: 80, OX: 56, WL: 27, wl: 270, lag: 0, spd: 6, ph: 350, a: -60, b: 450, dir: -1 },\n  ]\n  const SRC = [[F.hen[0], F.hen[1]], [F.dk0[0], F.dk0[1]], [F.dk1[0], F.dk1[1]], [F.dk2[0], F.dk2[1]], [F.drake[0], F.drake[1]]]\n  const tick = () => {\n    const t = (Date.now() - t0) / 1000\n    D.forEach((d, i) => {\n      const p = pp(t - d.lag, d.spd, d.a, d.b, d.ph), dir = p[1]\n      const x = Math.round(p[0] - (dir > 0 ? d.OX : d.W2 - d.OX)), y = Math.round(d.wl - d.WL + 0.9 * Math.sin(t * 1.4 + i))\n      if (dir !== d.dir) { d.dir = dir; d.w.setProperty(ui.prop.MORE, { x: pxv(x), y: pxv(y), src: dir > 0 ? SRC[i][0] : SRC[i][1] }) }\n      else d.w.setProperty(ui.prop.MORE, { x: pxv(x), y: pxv(y) })\n    })\n    W.mistA.setProperty(ui.prop.MORE, { x: pxv(-Math.round((t * 3) % 390)), y: pxv(150 + Math.round(6 * Math.sin(t * Math.PI / 30))) })\n    W.mistB.setProperty(ui.prop.MORE, { x: pxv(-390 + Math.round((t * 5) % 390)), y: pxv(296 - Math.round(4 * Math.sin(t * Math.PI / 30))) })\n  }\n  let id = null\n  const safe = () => { try { tick() } catch (e) {} }\n  const stop = () => { if (id === null) return; try { clearInterval(id) } catch (e) {} id = null }\n  const start = () => { if (id !== null) return; try { id = setInterval(safe, MS) } catch (e) {} }\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: () => { start() }, pause_call: stop })\n  safe()\n  start()\n}",
  "optimizePng": 24
}