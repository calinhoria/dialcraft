  "savePath": null,
  "userCode": "{\n  // the seconds scroll: one tall strip pushed down inside its box with pos_y, 20 times a second (a picture swap would reset the box, so the window size is sent every time)\n  const OFF = 50 - 22, WIN = { w: pxv(54), h: pxv(100) };\n  const tick = () => {\n    const d = new Date();\n    const t = d.getSeconds() + d.getMilliseconds() / 1000, s = Math.floor(t);\n    W.reel.setProperty(ui.prop.MORE, { w: WIN.w, h: WIN.h, pos_y: Math.round(OFF - (62 - s) * 44 + (t - s) * 44) });\n  };\n  // a colour-theme switch rebuilds the whole face and runs this block again: keep one timer and one screen-on/off delegate for the whole session\n  const G = globalThis;\n  try { if (G.__halfTm) clearInterval(G.__halfTm); } catch (e) {}\n  G.__halfTick = tick;\n  const start = () => { try { if (G.__halfTm) clearInterval(G.__halfTm); } catch (e) {} G.__halfTick(); G.__halfTm = setInterval(() => G.__halfTick(), 50); };\n  const stop = () => { try { if (G.__halfTm) clearInterval(G.__halfTm); } catch (e) {} G.__halfTm = 0; };\n  start();\n  if (!G.__halfDel) { G.__halfDel = 1; ui.createWidget(ui.widget.WIDGET_DELEGATE, { pause_call: stop, resume_call: start }); }\n}",
