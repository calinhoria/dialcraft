  "userCode": "{\n  // Pendulum Waves: bead i swings N0+i times a minute along its hour spoke, so all 12 line up on the outer ring at every minute start.\n  // k = harmonic number of the shape = t/5, so the ring turns into a shifted ring, an ellipse, a trefoil ... a 6-lobed gear at 30 s and back.\n  const MS = 110, DCX = 195, DCY = 227, R0 = 142, A = 23, RT = 100, N0 = 4, HZ = 16, HH = 22, MH = 17, TAU = 6.283185307179586;\n  const V = {\"w0\":{\"mid\":0,\"on\":1,\"off\":2,\"__blank\":3},\"w1\":{\"on\":0,\"mid\":1,\"off\":2,\"__blank\":3},\"w2\":{\"on\":0,\"mid\":1,\"off\":2,\"__blank\":3},\"w3\":{\"mid\":0,\"on\":1,\"off\":2,\"__blank\":3},\"w4\":{\"off\":0,\"mid\":1,\"on\":2,\"__blank\":3},\"w5\":{\"off\":0,\"mid\":1,\"on\":2,\"__blank\":3},\"w6\":{\"on\":0,\"mid\":1,\"off\":2,\"__blank\":3},\"w7\":{\"on\":0,\"mid\":1,\"off\":2,\"__blank\":3},\"w8\":{\"mid\":0,\"on\":1,\"off\":2,\"__blank\":3},\"w9\":{\"off\":0,\"mid\":1,\"on\":2,\"__blank\":3},\"w10\":{\"off\":0,\"mid\":1,\"on\":2,\"__blank\":3},\"w11\":{\"mid\":0,\"on\":1,\"off\":2,\"__blank\":3},\"hb\":{\"s\":0,\"__blank\":1},\"mb\":{\"s\":0,\"__blank\":1}};\n  const sl = []; let hb, mb;   // slot() comes from the runtime below, so the setters are made on the first tick\n  const tick = () => {\n    if (!hb) { for (let i = 0; i < 12; i++) sl.push(slot('w' + i)); hb = slot('hb'); mb = slot('mb'); }\n    const d = new Date(), t = d.getSeconds() + d.getMilliseconds() / 1000;\n    for (let i = 0; i < 12; i++) {\n      const c = Math.cos(TAU * (N0 + i) * t / 60), r = R0 + A * c, a = i * TAU / 12;\n      sl[i](Math.round(DCX + r * Math.sin(a) - HZ), Math.round(DCY - r * Math.cos(a) - HZ), c > 0.5 ? V['w' + i].on : c > -0.25 ? V['w' + i].mid : V['w' + i].off);\n    }\n    const ma = ((d.getMinutes() + t / 60) / 60) * TAU, ha = (((d.getHours() % 12) + d.getMinutes() / 60 + t / 3600) / 12) * TAU;\n    hb(Math.round(DCX + RT * Math.sin(ha) - HH), Math.round(DCY - RT * Math.cos(ha) - HH), V.hb.s);\n    mb(Math.round(DCX + RT * Math.sin(ma) - MH), Math.round(DCY - RT * Math.cos(ma) - MH), V.mb.s);\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
