  "savePath": null,
  "userCode": "{\n  const MS = 90, NC = 4, NF = 8, NS = 6, NCK = 20\n  const CKROT = [13,2,16,6]\n  const SZ = [{ w: 50, h: 43, r: 16, pts: 25, sp: [38, 62], y: [66, 190] }, { w: 90, h: 76, r: 25, pts: 10, sp: [70, 105], y: [140, 290] }]\n  let seed = 9\n  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647\n  const ri = (a, b) => a + rnd() * (b - a)\n  const mv = (w, x, y, src) => { if (src === undefined) w.setProperty(ui.prop.MORE, { x: pxv(Math.round(x)), y: pxv(Math.round(y)) }); else w.setProperty(ui.prop.MORE, { x: pxv(Math.round(x)), y: pxv(Math.round(y)), src }) }\n  const away = (w) => w.setProperty(ui.prop.MORE, { x: pxv(-200), y: pxv(0) })\n  const ci = (k, canon) => F['ck' + k][(canon - CKROT[k] + NCK) % NCK]\n  const B = []\n  for (let k = 0; k < NC; k++) B.push({ w: W['ck' + k], on: false, hit: false, x: 0, y: 0, y0: 0, vx: 0, vy: 0, dir: 1, sz: 0, amp: 0, fq: 0, ph: 0, rate: 9, next: 0.4 + k * 0.9, shown: true, last: -1 })\n  const FE = []\n  for (let i = 0; i < NF; i++) FE.push({ w: W['fe' + i], on: false, x: 0, y: 0, vx: 0, vy: 0, t: 0, k: i % 2 })\n  const PO = [{ w: W.po0, on: false, x: 0, y: 0, t: 0, rot: 1 }, { w: W.po1, on: false, x: 0, y: 0, t: 0, rot: 0 }]\n  const SH = []; for (let i = 0; i < NS; i++) SH.push(W['sh' + i])\n  const shx = (i) => 262 + i * 16\n  const X = { w: W.cross, x: 232, y: 114, tgt: null, ex: 0, ey: 0, fireUntil: 0, nextShot: 0, ammo: NS, reloadAt: 0, popI: 0, feI: 0, fire: false }\n  let t = 0, last = 0, id = null\n  const spawn = (b) => {\n    b.sz = rnd() < 0.42 ? 1 : 0; const s = SZ[b.sz]\n    b.dir = rnd() < 0.5 ? 1 : -1; b.on = true; b.hit = false\n    b.x = b.dir > 0 ? -s.w : 390; b.y0 = ri(s.y[0], s.y[1]); b.y = b.y0; b.vx = b.dir * ri(s.sp[0], s.sp[1]); b.vy = 0\n    b.amp = ri(5, 16); b.fq = ri(1.2, 2.6); b.ph = rnd() * 6; b.rate = ri(8, 11); b.last = -1; b.shown = false\n  }\n  const burst = (cx, cy) => { for (let n = 0; n < 6; n++) { const f = FE[X.feI++ % NF]; f.on = true; f.x = cx; f.y = cy; f.vx = ri(-90, 90); f.vy = ri(-110, -10); f.t = 0 } }\n  const popup = (cx, cy, pts) => { const p = PO[X.popI++ % 2]; p.on = true; p.x = cx - 23; p.y = cy - 30; p.t = 0; p.idx = pts === 50 ? 2 : pts === 25 ? 1 : 0 }\n  const pick = () => {\n    let best = null, bd = 1e9\n    for (const b of B) { if (!b.on || b.hit) continue; const s = SZ[b.sz], cx = b.x + s.w / 2, cy = b.y + s.h / 2; if (cx < 14 || cx > 376 || cy < 30 || cy > 330) continue; const d = Math.hypot(cx - X.x, cy - X.y) - s.pts * 2; if (d < bd) { bd = d; best = b } }\n    return best\n  }\n  const tick = () => {\n    const now = Date.now(); let dt = last ? (now - last) / 1000 : MS / 1000; dt = Math.min(0.15, dt); last = now; t += dt\n    // birds\n    for (const b of B) {\n      const s = SZ[b.sz]\n      if (!b.on) { if (b.shown) { away(b.w); b.shown = false } if (t >= b.next) spawn(b); continue }\n      if (b.hit) { b.vy += 430 * dt; b.y += b.vy * dt; b.x += b.vx * dt; mv(b.w, b.x, b.y, ci(b.id, 16 + b.sz * 2 + (Math.floor(t * 6) % 2))); b.shown = true; if (b.y > 400) { b.on = false; b.next = t + ri(0.4, 1.6) } continue }\n      b.x += b.vx * dt; b.y = b.y0 + Math.sin(t * b.fq + b.ph) * b.amp\n      if ((b.dir > 0 && b.x > 392) || (b.dir < 0 && b.x < -s.w - 4)) { b.on = false; b.next = t + ri(0.3, 1.4); away(b.w); b.shown = false; continue }\n      const f = Math.floor(t * b.rate) % 4, key = f + b.dir * 10\n      if (key !== b.last || !b.shown) { b.last = key; b.shown = true; mv(b.w, b.x, b.y, ci(b.id, (b.sz * 2 + (b.dir > 0 ? 0 : 1)) * 4 + f)) } else mv(b.w, b.x, b.y)\n    }\n    // the player\n    const reloading = X.reloadAt > t\n    if (X.ammo === 0 && !reloading && X.reloadAt === 0) X.reloadAt = t + 1.5\n    if (X.reloadAt && t >= X.reloadAt) { X.reloadAt = 0; X.ammo = NS; for (let i = 0; i < NS; i++) mv(SH[i], shx(i), 382) }\n    if (!X.tgt || !X.tgt.on || X.tgt.hit) { X.tgt = pick(); if (X.tgt) { const r = SZ[X.tgt.sz].r; X.ex = ri(-1, 1) * r * 1.1; X.ey = ri(-1, 1) * r * 1.1 } }\n    let ax = 195 + Math.sin(t * 0.7) * 60, ay = 230 + Math.cos(t * 0.5) * 30\n    if (X.tgt) { const b = X.tgt, s = SZ[b.sz]; ax = b.x + s.w / 2 + b.vx * 0.22 + X.ex; ay = b.y + s.h / 2 + X.ey }\n    const dx = ax - X.x, dy = ay - X.y, d = Math.hypot(dx, dy), sp = Math.min(300, d * 7) * dt\n    if (d > 0.5) { X.x += dx / d * Math.min(sp, d); X.y += dy / d * Math.min(sp, d) }\n    if (X.tgt && !reloading && X.ammo > 0 && t >= X.nextShot && d < 7) {\n      X.ammo--; mv(SH[X.ammo], -200, 0); X.fireUntil = t + 0.14; X.nextShot = t + ri(0.32, 0.6)\n      const b = X.tgt, s = SZ[b.sz], cx = b.x + s.w / 2, cy = b.y + s.h / 2\n      if (Math.hypot(cx - X.x, cy - X.y) < s.r) { b.hit = true; b.vy = -60; b.vx *= 0.3; burst(cx, cy); popup(cx, cy, s.pts); X.tgt = null }\n      else { X.ex = ri(-1, 1) * s.r * 0.8; X.ey = ri(-1, 1) * s.r * 0.8 }\n    }\n    const fire = t < X.fireUntil\n    mv(X.w, X.x - 20, X.y - 20, fire !== X.fire ? F.cross[fire ? 1 : 0] : undefined); X.fire = fire\n    // feathers and popups\n    for (const f of FE) { if (!f.on) continue; f.t += dt; f.vy += 70 * dt; f.x += (f.vx + Math.sin(f.t * 9 + f.k) * 30) * dt; f.y += f.vy * dt; f.vx *= 0.985; if (f.t > 1.1) { f.on = false; away(f.w) } else mv(f.w, f.x, f.y, F['fe' + FE.indexOf(f)][(Math.floor(f.t * 8) + f.k) % 2]) }\n    for (const p of PO) { if (!p.on) continue; p.t += dt; if (p.t > 0.9) { p.on = false; away(p.w) } else mv(p.w, p.x, p.y - p.t * 26, F[p.w === W.po0 ? 'po0' : 'po1'][(p.idx - p.rot + 3) % 3]) }\n  }\n  B.forEach((b, i) => { b.id = i })\n  const safe = () => { try { tick() } catch (e) {} }\n  const stop = () => { if (id === null) return; try { clearInterval(id) } catch (e) {} id = null }\n  const start = () => { if (id !== null) return; last = 0; try { id = setInterval(safe, MS) } catch (e) {} }\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop })\n  safe()\n  start()\n}",
  "optimizePng": 32
}