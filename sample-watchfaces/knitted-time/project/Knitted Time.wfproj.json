  "userCode": "{\n  // Knitted Time: the needles click, the ball of yarn rocks, and one minute of scarf grows from the needles (it restarts every minute)\n  const MS = 130;\n  const V = {\"ball\":{\"f1\":0,\"f0\":1,\"f2\":2,\"f3\":3,\"f4\":4,\"f5\":5,\"f6\":6,\"f7\":7,\"__blank\":8},\"needles\":{\"b\":0,\"a\":1,\"__blank\":2},\"swatch\":{\"s\":0,\"__blank\":1}};\n  const tick = () => {\n    const now = Date.now(), sec = (now % 60000) / 1000;\n    slot('ball')(34 + Math.round(2 * Math.sin(now / 650)), 372, V.ball['f' + (Math.floor(now / 260) % 8)]);\n    slot('needles')(232, 292, Math.floor(now / 500) % 2 ? V.needles.a : V.needles.b);\n    const h = Math.round(80 * sec / 60);\n    if (h >= 3) slot('swatch')(248, 322, V.swatch.s, 44, h); else slot('swatch').hide();\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
