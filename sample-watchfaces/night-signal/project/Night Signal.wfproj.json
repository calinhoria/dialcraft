  "userCode": "{const V = {\"beacon\":{\"1\":1,\"__blank\":0},\"pulse\":{\"0\":1,\"1\":2,\"__blank\":0},\"original\":{\"0\":0,\"__blank\":1}}; const P=[], D=[[86,18],[110,18],[133,18],[157,18],[181,18],[204,18],[228,18],[252,18],[275,18],[299,18],[322,21],[344,31],[360,47],[370,69],[372,92],[372,116],[372,140],[372,163],[372,187],[372,211],[372,234],[372,258],[372,282],[372,305],[372,329],[372,353],[371,376],[363,398],[348,416],[327,428],[304,432],[280,432],[257,432],[233,432],[209,432],[186,432],[162,432],[138,432],[115,432],[91,432],[68,429],[46,419],[30,403],[20,381],[18,358],[18,334],[18,310],[18,287],[18,263],[18,239],[18,216],[18,192],[18,168],[18,145],[18,121],[18,97],[19,74],[27,52],[42,34],[63,22],[86,18]], MS=100; const tick=()=>{\nconst d=new Date(),[x,y]=D[d.getMinutes()];\nif(d.getMinutes()===24&&d.getMilliseconds()<300){slot('beacon').hide();slot('pulse').hide();slot('original')(176,286,V.original[0]);return;}slot('original').hide();slot('beacon')(x-10,y-10,V.beacon[1]);\nslot('pulse')(183,337,V.pulse[d.getMilliseconds()<300?1:0]);\n};   // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { tick(); };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n}"
}
