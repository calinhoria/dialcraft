  "userCode": "{\n  // Bon fiscal: each minute the receipt is printed line by line from the top, held, and wiped\n  const MS = 100, PT = 56, PH = 348, PX = 60, LH = 22;\n  const V = {\"cover\":{\"__blank\":0,\"s\":1},\"head\":{\"__blank\":0,\"s\":1}};\n  const ease = (t) => { t = Math.max(0, Math.min(1, t)); return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };\n  const tick = () => {\n    const now = Date.now(), d = new Date(now), sec = d.getSeconds() + (now % 1000) / 1000;\n    let cy = PT - 6, ch = PH + 6;\n    if (sec < 0.6) { /* paper still blank */ }\n    else if (sec < 6.0) { const r = Math.round(ease((sec - 0.6) / 5.4) * PH / LH) * LH; cy = PT - 6 + r; ch = PH + 6 - r; }\n    else if (sec < 58.6) { ch = 0; }\n    else { const k = ease((sec - 58.6) / 1.0); ch = Math.round((PH + 6) * k); }\n    if (ch > 1) slot('cover')(PX - 8, cy, V.cover.s, 286, ch); else slot('cover').hide();\n    if (sec >= 0.6 && sec < 6.0 && ch > 1) slot('head')(PX, cy - 3, V.head.s); else slot('head').hide();\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
