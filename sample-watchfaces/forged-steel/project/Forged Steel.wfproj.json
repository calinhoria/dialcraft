  "userImports": "import { HeartRate as GaugeHeartRate, Battery as GaugeBattery } from '@zos/sensor'",
  "userCode": "{\n  const normal = ui.show_level.ONLY_NORMAL\n  const digitWidth = 18\n  const digitHeight = 22\n  const advance = 17\n  const percentWidth = 22\n  const blank = A('reading-blank.png')\n\n  function makeReading(center, top, percent) {\n    const slots = Array.from({ length: 3 }, () =>\n      ui.createWidget(ui.widget.IMG, {\n        x: pxv(center), y: pxv(top), w: pxv(digitWidth), h: pxv(digitHeight),\n        src: blank, show_level: normal,\n      })\n    )\n    const suffix = percent ? ui.createWidget(ui.widget.IMG, {\n      x: pxv(center), y: pxv(top), w: pxv(percentWidth), h: pxv(digitHeight),\n      src: blank, show_level: normal,\n    }) : null\n    let previous\n    return (value) => {\n      if (previous === value) return\n      const digits = value === null ? '--' : String(value)\n      const showPercent = percent && value !== null\n      const textWidth = digitWidth + (digits.length - 1) * advance\n      const width = textWidth + (showPercent ? percentWidth : 0)\n      const left = Math.round(center - width / 2)\n      slots.forEach((slot, index) => {\n        const char = digits[index]\n        const src = char ? A(char === '-' ? 'reading-dash.png' : 'reading-' + char + '.png') : blank\n        slot.setProperty(ui.prop.MORE, { x: pxv(left + index * advance), src })\n      })\n      if (suffix) suffix.setProperty(ui.prop.MORE, {\n        x: pxv(left + textWidth - 1),\n        src: showPercent ? A('reading-percent.png') : blank,\n      })\n      previous = value\n    }\n  }\n\n  function makeRing(centerX, centerY, sweep) {\n    return ui.createWidget(ui.widget.ARC_PROGRESS, {\n      center_x: pxv(centerX), center_y: pxv(centerY), radius: pxv(43),\n      start_angle: 0, end_angle: sweep, line_width: pxv(5),\n      color: 0xff790a, level: 0, show_level: normal,\n    })\n  }\n\n  function makeSensor(Sensor) {\n    try { return new Sensor() } catch (error) { return null }\n  }\n\n  function readSensor(sensor, method, min, max) {\n    try {\n      const value = sensor[method]()\n      return Number.isFinite(value) && value >= min && value <= max ? Math.round(value) : null\n    } catch (error) {\n      return null\n    }\n  }\n\n  const heart = makeSensor(GaugeHeartRate)\n  const battery = makeSensor(GaugeBattery)\n  const heartRing = makeRing(195, 290, 125)\n  const batteryRing = makeRing(292, 294, 98)\n  const displayHeart = makeReading(195, 289, false)\n  const displayBattery = makeReading(292, 295, true)\n\n  function updateHeart() {\n    const value = readSensor(heart, 'getLast', 1, 255)\n    displayHeart(value)\n    heartRing.setProperty(ui.prop.LEVEL, value === null ? 0 : Math.min(100, value))\n  }\n\n  function updateBattery() {\n    const value = readSensor(battery, 'getCurrent', 0, 100)\n    displayBattery(value)\n    batteryRing.setProperty(ui.prop.LEVEL, value === null ? 0 : value)\n  }\n\n  function update() {\n    updateHeart()\n    updateBattery()\n  }\n\n  update()\n  // Refresh when passive heart-rate data changes, and after waking the face.\n  let refreshTimer = null\n  function start() {\n    update()\n    if (refreshTimer === null) refreshTimer = setInterval(update, 15000)\n  }\n  function stop() {\n    if (refreshTimer !== null) clearInterval(refreshTimer)\n    refreshTimer = null\n  }\n  try { if (heart) heart.onLastChange(updateHeart) } catch (error) {}\n  try { if (battery) battery.onChange(updateBattery) } catch (error) {}\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop })\n}\n"
}
