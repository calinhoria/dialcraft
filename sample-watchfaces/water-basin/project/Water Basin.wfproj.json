  "userCode": "{\n  // Water Basin: every 6 s a drop forms on the leaf tip, falls, and splashes into the basin; two rings spread out and fade.\n  // The impact is on every multiple of 6 seconds, so a drop lands exactly as the minute changes.\n  const MS = 90;\n  const V = {\"ripA\":{\"__blank\":0,\"r1\":1,\"r2\":2,\"r3\":3,\"r4\":4,\"r5\":5,\"r0\":6},\"ripB\":{\"__blank\":0,\"r1\":1,\"r2\":2,\"r3\":3,\"r4\":4,\"r5\":5,\"r0\":6},\"splash\":{\"__blank\":0,\"s1\":1,\"s2\":2,\"s3\":3,\"s4\":4,\"s5\":5,\"s6\":6,\"s7\":7,\"s0\":8},\"drop\":{\"f\":0,\"b2\":1,\"b3\":2,\"b1\":3,\"__blank\":4}};\n  const P = 6, TI = 2.6;               // cycle length, the moment of impact in the cycle\n  const FALL0 = 1.8, TIP_Y = 96, WATER_Y = 338, DX = 241, RX = 166, RY = 322;\n  const tick = () => {\n    const d = new Date(), t = d.getSeconds() + d.getMilliseconds() / 1000;\n    const c = (t + TI) % P;            // c in [0,P): the drop is at the tip from c = 0 and lands at c = TI, i.e. when t is a multiple of 6\n    // the drop\n    if (c < FALL0) slot('drop')(DX, TIP_Y, V.drop[c < 0.6 ? 'b1' : c < 1.2 ? 'b2' : 'b3']);\n    else if (c < TI) { const q = (c - FALL0) / (TI - FALL0); slot('drop')(DX, Math.round(TIP_Y + 8 + (WATER_Y - TIP_Y - 8) * q * q), V.drop.f); }\n    else slot('drop').hide();\n    // the splash and the rings after the impact (age = seconds since impact)\n    const age = c >= TI ? c - TI : -1;\n    if (age >= 0 && age < 0.88) slot('splash')(191, 292, V.splash['s' + Math.min(7, Math.floor(age / 0.11))]); else slot('splash').hide();\n    const ring = (h, a) => { if (a >= 0 && a < 2.4) slot(h)(RX, RY, V[h]['r' + Math.min(5, Math.floor(a / 0.4))]); else slot(h).hide(); };\n    ring('ripA', age);\n    ring('ripB', age >= 0 ? age - 0.7 : -1);\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
