  "savePath": null,
  "userImports": "import { Time as DCTime } from '@zos/sensor'",
  "userCode": "{\n  // Once a minute Mario jumps, bumps the question block (the minute) and a coin pops out. A Goomba strolls by, clouds drift.\n  const MS = 80, BLOCK_Y = 84, MARIO_Y = 296, JUMP_MS = 700, JUMP_H = 72, QX = 200, GOOMBA_S = 36\n  const img = (n) => A('act/' + n + '.png')\n  let id = null, n = 0, lastMin = -1, t0 = -9999, clock = null\n  try { clock = new DCTime() } catch (e) {}\n  const minute = () => {\n    try { if (clock) { const v = clock.getMinutes(); if (typeof v === 'number' && v >= 0) return v } } catch (e) {}\n    try { return new Date().getMinutes() } catch (e) {}\n    return 0\n  }\n  const tick = () => {\n    n++\n    const now = Date.now(), m = minute()\n    if (lastMin >= 0 && m !== lastMin) t0 = now\n    lastMin = m\n    const t = now - t0\n    // Mario: stand, or up and down in a parabola\n    const u = Math.min(1, Math.max(0, t / JUMP_MS))\n    const rise = t >= 0 && t < JUMP_MS ? Math.round(JUMP_H * 4 * u * (1 - u)) : 0\n    W.mar.setProperty(ui.prop.MORE, { x: pxv(259), y: pxv(MARIO_Y - rise), src: img(rise > 0 ? 'mario_1' : 'mario_0') })\n    // block bump at the top of the jump, coin pops out\n    const tb = t - JUMP_MS / 2\n    const bump = tb >= 0 && tb < 220 ? Math.round(-12 * Math.sin(Math.PI * tb / 220)) : 0\n    W.qb.setProperty(ui.prop.MORE, { x: pxv(QX), y: pxv(BLOCK_Y + bump) })\n    if (tb >= 0 && tb < 620) W.coin.setProperty(ui.prop.MORE, { x: pxv(271), y: pxv(Math.round(BLOCK_Y - 34 - 40 * Math.min(1, tb / 500))), src: img('coin_' + (Math.floor(tb / 70) % 4)) })\n    else W.coin.setProperty(ui.prop.MORE, { x: pxv(271), y: pxv(100), src: img('coin_0') })\n    // Goomba walks left across the ground\n    const gp = (now / 1000 % GOOMBA_S) / GOOMBA_S\n    W.gob.setProperty(ui.prop.MORE, { x: pxv(Math.round(390 - gp * 470)), y: pxv(GROUND_Y), src: img('goomba_' + (Math.floor(now / 220) % 2)) })\n    // clouds\n    W.cl0.setProperty(ui.prop.MORE, { x: pxv(Math.round(((now / 1000) * 6) % 520 - 100)), y: pxv(236), src: img('cloud_0') })\n    W.cl1.setProperty(ui.prop.MORE, { x: pxv(Math.round(((now / 1000) * 4 + 260) % 520 - 100)), y: pxv(284), src: img('cloud_1') })\n  }\n  const GROUND_Y = 320\n  const safe = () => { try { tick() } catch (e) {} }\n  const start = () => { if (id === null) { try { id = setInterval(safe, MS) } catch (e) {} } }\n  const stop = () => { if (id !== null) { try { clearInterval(id) } catch (e) {} id = null } }\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop })\n  safe()\n  start()\n}",
  "optimizePng": 32
