  "optimizePng": 32,
  "userCode": "{\n  // Subtitrare: subtitles narrate in turn over a title card, with a little film dust\n  const MS = 100, TOP = 62;\n  const LN = ['[muzică ominoasă]', '[pași în depărtare…]', '— Chiar e doar ora asta?'], WIN = [[0.7, 3.2], [3.5, 6.0], [6.3, 8.6]];\n  const V = {\"sub\":{\"__blank\":0,\"[muzică ominoasă]1\":1,\"[pași în depărtare…]0.5\":2,\"[pași în depărtare…]1\":3,\"— Chiar e doar ora asta?0.5\":4,\"— Chiar e doar ora asta?1\":5,\"[muzică ominoasă]0.5\":6},\"dust0\":{\"s\":0,\"__blank\":1},\"dust1\":{\"s\":0,\"__blank\":1},\"dust2\":{\"s\":0,\"__blank\":1},\"scr\":{\"s\":0,\"__blank\":1}};\n  const sr = (n) => { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };\n  const tick = () => {\n    const now = Date.now(), t = (now / 1000) % 9, k = Math.floor(now / 100);\n    let shown = false;\n    for (let i = 0; i < 3 && !shown; i++) {\n      const a = WIN[i][0], b = WIN[i][1];\n      if (t >= a && t <= b) { const al = Math.min((t - a) / 0.35, (b - t) / 0.35) < 0.5 ? 0.5 : 1; slot('sub')(15, 330, V.sub[LN[i] + al]); shown = true; }\n    }\n    if (!shown) slot('sub').hide();\n    for (let i = 0; i < 3; i++) { if (sr(k * 3 + i) > 0.45) slot('dust' + i)(Math.round(20 + sr(k + i * 7) * 350), Math.round(TOP + 8 + sr(k * 2 + i) * 300), V['dust' + i].s); else slot('dust' + i).hide(); }\n    if (k % 7 === 0) slot('scr')(Math.round(60 + sr(k) * 270), TOP, V.scr.s); else slot('scr').hide();\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
