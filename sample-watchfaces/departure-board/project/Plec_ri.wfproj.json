  "savePath": null,
  "optimizePng": 32,
  "userCode": "{\n  // Plecări: every 15 s the three departures flip to a new deadpan status; a digit that changes flashes its flap line\n  const MS = 100, NS = 4, STEP = 15000;\n  const V = {\"row0\":{\"t2\":0,\"t1\":1,\"t0\":2,\"t3\":3,\"n0\":4,\"n1\":5,\"n2\":6,\"n3\":7,\"__blank\":8},\"row1\":{\"t2\":0,\"t1\":1,\"t0\":2,\"t3\":3,\"n0\":4,\"n1\":5,\"n2\":6,\"n3\":7,\"__blank\":8},\"row2\":{\"t2\":0,\"t1\":1,\"t0\":2,\"t3\":3,\"n0\":4,\"n1\":5,\"n2\":6,\"n3\":7,\"__blank\":8},\"fm0\":{\"__blank\":0,\"s\":1},\"fm1\":{\"__blank\":0,\"s\":1},\"fm2\":{\"__blank\":0,\"s\":1},\"fm3\":{\"__blank\":0,\"s\":1}};\n  let prev = '', flipUntil = [0, 0, 0, 0];\n  const tick = () => {\n    const now = Date.now(), d = new Date(now), p2 = (n) => (n < 10 ? '0' : '') + n;\n    const hm = p2(d.getHours()) + p2(d.getMinutes());\n    if (prev && hm !== prev) for (let i = 0; i < 4; i++) if (hm[i] !== prev[i]) flipUntil[i] = now + 260;\n    prev = hm;\n    for (let i = 0; i < 4; i++) { if (now < flipUntil[i]) slot('fm' + i)(([52, 116, 216, 280])[i], 70, V['fm' + i].s); else slot('fm' + i).hide(); }\n    const idx = Math.floor(now / STEP), into = (now % STEP) / 1000;\n    for (let r = 0; r < 3; r++) {\n      const k = idx % NS, tr = into - r * 0.45;                    // seconds since this row's flip began\n      let show = V['row' + r]['t' + k];\n      if (tr >= 0 && tr < 0.5) show = V['row' + r]['n' + (Math.floor(tr * 10) % 4)];\n      else if (tr < 0) show = V['row' + r]['t' + ((k + NS - 1) % NS)];\n      slot('row' + r)(36, 214 + r * 56, show);\n    }\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
  "userImports": ""
}