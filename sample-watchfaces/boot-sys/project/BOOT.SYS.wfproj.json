  "userCode": "{\n  // BOOT.SYS: every minute the watch runs a short check and reports each reading in one deadpan word\n  const MS = 100, LY = 82, LH = 27;\n  const POOLN = [4, 4, 4, 4, 4];\n  const V = {\"cv0\":{\"__blank\":0,\"s\":1},\"tg0\":{\"[ ÎN CREȘTERE ]\":0,\"[ SUSPECT ]\":1,\"[ NU CONTEAZĂ ]\":2,\"[ BINE ]\":3,\".0\":4,\".1\":5,\".2\":6,\".3\":7,\"__blank\":8},\"cv1\":{\"__blank\":0,\"s\":1},\"tg1\":{\"[ RELAXAT ]\":0,\"[ AGITAT ]\":1,\"[ ÎN VIAȚĂ ]\":2,\"[ CALM SUSPECT ]\":3,\".0\":4,\".1\":5,\".2\":6,\".3\":7,\"__blank\":8},\"cv2\":{\"__blank\":0,\"s\":1},\"tg2\":{\"[ LA LIMITĂ ]\":0,\"[ OPTIMIST ]\":1,\"[ SUFICIENT ]\":2,\"[ NEGOCIABIL ]\":3,\".0\":4,\".1\":5,\".2\":6,\".3\":7,\"__blank\":8},\"cv3\":{\"__blank\":0,\"s\":1},\"tg3\":{\"[ DE CASĂ ]\":0,\"[ ACCEPTABIL ]\":1,\"[ NEGOCIABIL ]\":2,\"[ REZERVAT ]\":3,\".0\":4,\".1\":5,\".2\":6,\".3\":7,\"__blank\":8},\"cv4\":{\"__blank\":0,\"s\":1},\"tg4\":{\"[ SIGUR ]\":0,\"[ PROGRAMAT ]\":1,\"[ ÎN CURÂND ]\":2,\"[ INEVITABIL ]\":3,\".0\":4,\".1\":5,\".2\":6,\".3\":7,\"__blank\":8},\"cur\":{\"s\":0,\"__blank\":1},\"cvp\":{\"__blank\":0,\"s\":1},\"sweep\":{\"__blank\":0,\"s\":1}};\n  const POOLK = [['BINE', 'SUSPECT', 'NU CONTEAZĂ', 'ÎN CREȘTERE'], ['ÎN VIAȚĂ', 'AGITAT', 'RELAXAT', 'CALM SUSPECT'], ['OPTIMIST', 'LA LIMITĂ', 'SUFICIENT', 'NEGOCIABIL'], ['DE CASĂ', 'ACCEPTABIL', 'NEGOCIABIL', 'REZERVAT'], ['INEVITABIL', 'PROGRAMAT', 'ÎN CURÂND', 'SIGUR']];\n  const tick = () => {\n    const now = Date.now(), d = new Date(now), sec = d.getSeconds() + (now % 1000) / 1000, mn = d.getMinutes();\n    for (let i = 0; i < 5; i++) {\n      const t0 = 0.9 + i * 0.62, shown = sec >= t0 && sec < 59.2, y0 = LY + (i + 1) * LH - 20;\n      if (shown) slot('cv' + i).hide(); else slot('cv' + i)(32, y0, V['cv' + i].s);\n      if (!shown) { slot('tg' + i).hide(); continue; }\n      if (sec > t0 + 0.28) slot('tg' + i)(196, y0, V['tg' + i]['[ ' + POOLK[i][(mn * 7 + i * 3) % 4] + ' ]']);\n      else slot('tg' + i)(196, y0, V['tg' + i]['.' + (Math.floor(now / 90) % 4)]);\n    }\n    const prompt = sec >= 4.0 && sec < 59.2;\n    if (prompt) { slot('cvp').hide(); if (Math.floor(now / 420) % 2 === 0) slot('cur')(34 + 146, LY + 6 * LH - 12, V.cur.s); else slot('cur').hide(); }\n    else { slot('cvp')(32, LY + 6 * LH - 14, V.cvp.s); slot('cur').hide(); }\n    if (sec > 58.4) slot('sweep')(0, Math.round(450 * (sec - 58.4) / 1.6), V.sweep.s); else slot('sweep').hide();\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
