  "userImports": "import * as SolarSensors from '@zos/sensor'",
  "userCode": "{\nfunction solarDialState(minute, rise, set) {\n  if (!Number.isFinite(rise) || !Number.isFinite(set) || rise < 0 || set >= 1440 || set <= rise) {\n    rise = 360;\n    set = 1080;\n  }\n  const daylight = set - rise;\n  const noon = (rise + set) / 2;\n  const wrap = (m) => ((m % 1440) + 1440) % 1440;\n  const sinceRise = wrap(minute - rise);\n  const day = sinceRise < daylight;\n  const fromHorizon = day ? Math.min(sinceRise, daylight - sinceRise) :\n    Math.min(sinceRise - daylight, 1440 - sinceRise);\n  // Zepp tide data gives the two horizon crossings. These three markers are estimated.\n  const twilight = [30, 60, 90].filter((offset) => offset < (1440 - daylight) / 2);\n  const sky = day ? (fromHorizon < 30 ? 1 : 0) :\n    fromHorizon < 30 ? 1 : fromHorizon < 60 ? 2 : fromHorizon < 90 ? 3 : 4;\n  const angleAt = (m) => (m - noon) / 4;\n  return {\n    angle: angleAt(minute),\n    day,\n    sky,\n    sunrise: angleAt(rise),\n    sunset: angleAt(set),\n    twilight: twilight.flatMap((offset) => [angleAt(rise - offset), angleAt(set + offset)]),\n  };\n}\nfunction solarDialPoint(dial, angle, radius = dial.radius) {\n  const radians = angle * Math.PI / 180;\n  return {\n    x: dial.centerX + radius * Math.sin(radians),\n    y: dial.centerY - radius * Math.cos(radians),\n  };\n}\nconst DIAL = { centerX: 195, centerY: 218.5, radius: 158, trackRadius: 175 };\nconst MARKER_SIZE = 69;\n\nfunction markerAt(angle) {\n  const point = solarDialPoint(DIAL, angle);\n  return { x: Math.round(point.x - MARKER_SIZE / 2), y: Math.round(point.y - MARKER_SIZE / 2) };\n}\n\nfunction solarTimes(weather) {\n  if (!weather) return [360, 1080];\n  // Firmware versions expose either method name.\n  for (const method of ['getForecastWeather', 'getForecast']) {\n    try {\n      if (typeof weather[method] !== 'function') continue;\n      const forecast = weather[method]();\n      const today = forecast && forecast.tideData && forecast.tideData.data && forecast.tideData.data[0];\n      if (!today) continue;\n      const rise = toMinutes(today.sunrise);\n      const set = toMinutes(today.sunset);\n      if (rise >= 0 && set > rise) return [rise, set];\n    } catch (error) { /* Try the alternate method or use the default daylight interval. */ }\n  }\n  return [360, 1080];\n}\n\nfunction toMinutes(time) {\n  if (!time || !Number.isInteger(time.hour) || !Number.isInteger(time.minute) ||\n      time.hour < 0 || time.hour > 23 || time.minute < 0 || time.minute > 59) return -1;\n  return time.hour * 60 + time.minute;\n}\n\nconst time = new SolarSensors.Time();\nlet weather;\ntry {\n  if (SolarSensors.Weather) weather = new SolarSensors.Weather();\n} catch (error) { /* Weather is optional. */ }\n\nconst normal = ui.show_level.ONLY_NORMAL;\nconst twilightColors = [0xdfaa81, 0xb594c7, 0x8299d3];\nconst track = [];\nlet lastMarker;\nlet lastSky;\nlet lastTide;\n\nfunction drawTrack(state) {\n  track.forEach((widget) => ui.deleteWidget(widget));\n  track.length = 0;\n  const radius = DIAL.trackRadius;\n  const arc = (start, end, color) => {\n    if (end <= start) return;\n    track.push(ui.createWidget(ui.widget.ARC, {\n      x: pxv(DIAL.centerX - radius), y: pxv(DIAL.centerY - radius),\n      w: pxv(radius * 2), h: pxv(radius * 2), radius: pxv(radius),\n      start_angle: start, end_angle: end, line_width: pxv(2), color, show_level: normal,\n    }));\n  };\n  arc(0, 359.99, 0x536d9d);\n  const start = (state.sunrise + 270) % 360;\n  const end = start + state.sunset - state.sunrise;\n  arc(start, Math.min(end, 360), 0xf6be59);\n  if (end > 360) arc(0, end - 360, 0xf6be59);\n  state.twilight.forEach((angle, index) => {\n    const point = solarDialPoint(DIAL, angle, radius - 8);\n    track.push(ui.createWidget(ui.widget.CIRCLE, {\n      center_x: pxv(point.x), center_y: pxv(point.y), radius: pxv(2),\n      color: twilightColors[Math.floor(index / 2)], show_level: normal,\n    }));\n  });\n}\n\nfunction update() {\n  const minute = time.getHours() * 60 + time.getMinutes();\n  const [rise, set] = solarTimes(weather);\n  const state = solarDialState(minute, rise, set);\n  const marker = markerAt(state.angle);\n  if (lastSky !== state.sky) {\n    W.solarSky.setProperty(ui.prop.SRC, F.solarSky[state.sky]);\n    lastSky = state.sky;\n  }\n  if (!lastMarker || marker.x !== lastMarker.x || marker.y !== lastMarker.y || state.day !== lastMarker.day) {\n    W.solarMarker.setProperty(ui.prop.MORE, {\n      x: pxv(marker.x), y: pxv(marker.y), src: F.solarMarker[state.day ? 0 : 1],\n    });\n    lastMarker = { ...marker, day: state.day };\n  }\n  const tide = rise * 1440 + set;\n  if (lastTide !== tide) {\n    lastTide = tide;\n    drawTrack(state);\n  }\n}\n\nupdate();\ntime.onPerMinute(update);\nui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: update });\n\n}"
}