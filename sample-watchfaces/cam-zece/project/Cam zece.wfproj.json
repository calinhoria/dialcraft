  "userCode": "{\n  // Cam zece: three phrases in turn - the time as people say it, the time of day, and a shrug\n  const MS = 100, LX = 38;\n  const HOURS = ['unu', 'două', 'trei', 'patru', 'cinci', 'șase', 'șapte', 'opt', 'nouă', 'zece', 'unsprezece', 'douăsprezece'];\n  const V = {\"la\":{\"pe la\":0,\"fix\":1,\"aproape\":2,\"hai\":3,\"e devreme\":4,\"încă puțin\":5,\"ora\":6,\"mai e mult\":7,\"seara\":8,\"__blank\":9},\"lb\":{\"zece\":0,\"două\":1,\"trei\":2,\"patru\":3,\"cinci\":4,\"șase\":5,\"șapte\":6,\"opt\":7,\"nouă\":8,\"unu\":9,\"unsprezece\":10,\"douăsprezece\":11,\"pentru\":12,\"până la\":13,\"prânzului\":14,\"până\":15,\"e a\":16,\"somnului\":17,\"__blank\":18},\"lc\":{\"și ceva\":0,\"sau cam\":1,\"dar nu chiar\":2,\"că vine\":3,\"orice\":4,\"prânz\":5,\"acasă\":6,\"ta\":7,\"cam.\":8,\"__blank\":9},\"rule\":{\"s\":0,\"__blank\":1},\"strike\":{\"s\":0,\"__blank\":1}};\n  const FW = 67;\n  const hw = (h) => HOURS[((h + 11) % 12)];\n  const approx = (h, m) => {\n    const H = hw(h), N = hw(h + 1);\n    if (m < 3) return ['fix', H, 'sau cam'];\n    if (m < 28) return ['pe la', H, 'și ceva'];\n    if (m < 58) return ['aproape', N, 'dar nu chiar'];\n    return ['hai', N, 'că vine'];\n  };\n  const tod = (h) => (h < 10 ? ['e devreme', 'pentru', 'orice'] : h < 12 ? ['încă puțin', 'până la', 'prânz'] : h < 14 ? ['ora', 'prânzului', ''] : h < 18 ? ['mai e mult', 'până', 'acasă'] : h < 22 ? ['seara', 'e a', 'ta'] : ['ora', 'somnului', '']);\n  const ease = (t) => 1 - Math.pow(1 - t, 3), cl = (v) => Math.max(0, Math.min(1, v));\n  const tick = () => {\n    const now = Date.now(), d = new Date(now), h = d.getHours(), m = d.getMinutes();\n    const idx = Math.floor(now / 3000), si = idx % 3, k = (now % 3000) / 1000;\n    let a, b, c, ya, yb, yc;\n    if (si === 0) { [a, b, c] = approx(h, m); ya = 82; yb = 110; yc = 160; }\n    else if (si === 1) { [a, b, c] = tod(h); ya = 82; yb = 84; yc = 188; }\n    else { a = ''; b = hw(m < 58 ? h : h + 1); c = 'cam.'; ya = 82; yb = 86; yc = 200; }\n    const ent = [cl(k / 0.5), cl((k - 0.09) / 0.5), cl((k - 0.18) / 0.5)], ext = cl((k - 2.6) / 0.4);\n    const put = (h2, text, y0, i) => {\n      if (!text || ent[i] <= 0 || ext >= 1) { slot(h2).hide(); return; }\n      slot(h2)(LX - 4, Math.round(y0 + (1 - ease(ent[i])) * 46 - ext * ext * 30), V[h2][text]);\n    };\n    put('la', a, ya, 0); put('lb', b, yb, 1); put('lc', c, yc, 2);\n    const rw = Math.round(314 * ease(cl((k - 0.2) / 0.7)) * (1 - cl((k - 2.7) / 0.3)));\n    if (rw > 0) slot('rule')(LX, 348, V.rule.s, rw, 1); else slot('rule').hide();\n    const sw = Math.round((FW + 4) * ease(cl(((now % 3000) / 1000 - 0.9) / 0.4)));\n    if (sw > 0) slot('strike')(LX - 2, 384, V.strike.s, sw, 2); else slot('strike').hide();\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
