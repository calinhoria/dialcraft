  "userCode": "{\n  // Orbit: the view from a space station. The night side of the Earth is the real time of day, a satellite and the odd shooting star cross.\n  const MS = 150;\n  const V = {\"night\":{\"h10\":0,\"h1\":1,\"h2\":2,\"h3\":3,\"h4\":4,\"h5\":5,\"h6\":6,\"h7\":7,\"h8\":8,\"h9\":9,\"h0\":10,\"h11\":11,\"h12\":12,\"h13\":13,\"h14\":14,\"h15\":15,\"h16\":16,\"h17\":17,\"h18\":18,\"h19\":19,\"h20\":20,\"h21\":21,\"h22\":22,\"h23\":23,\"__blank\":24},\"tw\":{\"c\":0,\"b\":1,\"a\":2,\"__blank\":3},\"sat\":{\"b\":0,\"a\":1,\"__blank\":2},\"shoot\":{\"__blank\":0,\"s\":1}};\n  const tick = () => {\n    const now = Date.now(), d = new Date(now);\n    // the day / night line follows the local time (one picture per hour, 15 degrees each)\n    const hh = d.getHours() + d.getMinutes() / 60;\n    slot('night')(0, 220, V.night['h' + (Math.floor(hh + 0.5) % 24)]);\n    // the stars twinkle in three phases\n    slot('tw')(0, 0, [V.tw.a, V.tw.b, V.tw.c][Math.floor(now / 900) % 3]);\n    // a satellite crosses the sky every 52 s, its beacon blinking\n    const p = (now % 52000) / 52000, sx = Math.round(-50 + p * 490);\n    if (sx > -44 && sx < 386) slot('sat')(sx, Math.round(176 + 9 * Math.sin(p * 6.283)), Math.floor(now / 500) % 2 ? V.sat.a : V.sat.b);\n    else slot('sat').hide();\n    // a shooting star every 37 s, a second long\n    const q = (now % 37000) / 1100;\n    if (q < 1) slot('shoot')(Math.round(330 - q * 250), Math.round(22 + q * 130), V.shoot.s);\n    else slot('shoot').hide();\n  };\n    // ---- shared runtime: slot setter that skips unchanged calls, and a loop that runs only while the face is on screen ----\n  const SL = {};\n  const slot = (h) => {\n    if (SL[h]) return SL[h];\n    const w = W[h], f = F[h]; let key = '';\n    const s = (x, y, i, ww, hh) => {\n      const k = x + '|' + y + '|' + i + '|' + ww + '|' + hh;\n      if (k === key) return;\n      key = k;\n      const p = { x: pxv(x), y: pxv(y) };\n      if (i !== undefined) p.src = f[i];\n      if (ww !== undefined) { p.w = pxv(ww); p.h = pxv(hh); }\n      w.setProperty(ui.prop.MORE, p);\n    };\n    s.hide = () => { if (key === 'hide') return; key = 'hide'; w.setProperty(ui.prop.MORE, { src: f[V[h].__blank] }); };\n    return (SL[h] = s);\n  };\n  let gen = 0, running = false;\n  const safe = () => { try { tick(); } catch (e) { /* a bad frame must not stop the loop */ } };\n  const loop = (g) => {\n    if (!running || g !== gen) return;\n    safe();\n    if (running && g === gen) { try { setTimeout(() => loop(g), MS); } catch (e) {} }\n  };\n  const start = () => {\n    gen++; running = true; const g = gen;\n    try { setTimeout(() => loop(g), MS); } catch (e) {}\n    safe();\n  };\n  const stop = () => { running = false; gen++; };\n  ui.createWidget(ui.widget.WIDGET_DELEGATE, { resume_call: start, pause_call: stop });\n  start();\n\n}\n",
  "userImports": ""
